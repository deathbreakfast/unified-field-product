#![allow(missing_docs)]
//! Tests for the reference and batch system

#[cfg(all(test, feature = "ssr"))]
mod tests {
    use orbital::generated::*;
    use valence::{BatchCreatable, ReferencedEntity, WithReference};

    async fn setup_db() -> surrealdb::Surreal<surrealdb::engine::local::Db> {
        let db = surrealdb::Surreal::new::<surrealdb::engine::local::Mem>(())
            .await
            .expect("Failed to create in-memory database");

        db.use_ns("test")
            .use_db("test")
            .await
            .expect("Failed to use namespace/database");

        db
    }

    #[tokio::test]
    async fn test_reference_creation() {
        // Create a reference
        let account_ref = AccountReference::new();

        // Reference should have an ID
        assert!(!account_ref.id().is_empty());
        assert!(account_ref.id().starts_with("ref_"));

        // Reference should start unresolved
        assert!(!account_ref.is_resolved());
        assert!(account_ref.resolve().is_none());
    }

    #[tokio::test]
    async fn test_reference_cloning() {
        // Create a reference
        let ref1 = AccountReference::new();
        let ref2 = ref1.clone();

        // Clones should share the same ID
        assert_eq!(ref1.id(), ref2.id());

        // Both references should start unresolved
        assert!(!ref1.is_resolved());
        assert!(!ref2.is_resolved());

        // Note: set_resolved is internal and only called by the batch system
        // Once batch creation is implemented, references will be automatically resolved
    }

    #[tokio::test]
    async fn test_with_reference_trait() {
        use chrono::Utc;

        // Create an account and a reference
        let now = Utc::now();
        let account = Account::new(
            "Acme".to_string(),
            None,
            None,
            "billing@acme.test".to_string(),
            now,
            now,
        )
        .expect("Failed to create account");
        let account_ref = AccountReference::new();

        // Use WithReference trait
        let referenced: ReferencedEntity<Account> = account.with_reference(account_ref.clone());

        // Check the reference
        assert_eq!(referenced.reference().id(), account_ref.id());

        // Check the entity
        assert_eq!(referenced.entity().name(), "Acme");
    }

    #[tokio::test]
    async fn test_reference_entity_construction() {
        use chrono::Utc;

        // Create an account and reference
        let now = Utc::now();
        let account = Account::new(
            "Acme".to_string(),
            None,
            None,
            "billing@acme.test".to_string(),
            now,
            now,
        )
        .expect("Failed to create account");
        let account_ref = AccountReference::new();

        // Create a referenced entity directly
        let referenced = ReferencedEntity::new(account_ref.clone(), account);

        // Verify we can get the reference and entity
        assert_eq!(referenced.reference().id(), account_ref.id());
        assert_eq!(referenced.entity().name(), "Acme");
    }

    #[tokio::test]
    async fn test_account_has_batch_creatable() {
        // This test just ensures the traits are implemented
        // The BatchCreatable trait should be implemented for Account

        // We can check the table name
        assert_eq!(Account::table_name(), "account");
    }
}
